# Copy to .env (never commit .env). Matches docker-compose defaults;
# point DB_URL at your own pluggable database if the name differs.
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USER=avms
DB_PASSWORD=avms
JWT_SECRET=change-me-to-a-256-bit-secret-please-change-me-123456
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=dev
