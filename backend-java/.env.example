# Copy to .env (never commit .env). Matches docker-compose defaults;
# point DB_URL at your own pluggable database if the name differs.
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USER=avms
DB_PASSWORD=avms
# Local-dev only (insecure). Prod requires a random 32+ char JWT_SECRET
# (see .env.prod.example and docker-compose.prod.yml which enforce it).
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-prod-0123456789
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=dev
