# Copy to .env.prod and fill in (never commit .env.prod).
# Used by: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Public domain pointing at your VPS, e.g. avms.example.com
DOMAIN=avms.example.com

# Frontend bakes this at build time. Keep in sync with DOMAIN.
VITE_API_URL=https://avms.example.com/api

# Oracle XE + app DB (use 3 different strong passwords)
ORACLE_PASSWORD=change-me-sys-strong-1
APP_USER_PASSWORD=change-me-app-strong-2
DB_PASSWORD=change-me-app-strong-2

# Auth signing key: 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-32-plus-random-chars-with-openssl
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

LOG_LEVEL=INFO

# Password-reset OTP emails (Gmail SMTP). Recommended: create a dedicated
# sending Gmail account, enable 2-Step Verification, then generate an
# "App Password" at https://myaccount.google.com/apppasswords (16 chars).
# SMTP_USER is the full Gmail address; SMTP_PASSWORD is the app password
# (spaces optional). Leave USER/PASSWORD empty to fall back to console
# delivery (OTP printed in backend logs — dev/demo use only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
