# ---------------------------------------------------------------------------
# AJAYA VENTURE - environment configuration template
# Copy to .env and fill real values. NEVER commit .env.
# Production: inject via Jenkins credentials / secret manager, NOT .env.
# ---------------------------------------------------------------------------

# Application environment: development | test | staging | production
APP_ENV=development

# Server (Tomcat) ports
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Oracle database connection (runtime AV_APP schema)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=orclpdb
DB_USERNAME=AV_APP
DB_PASSWORD=change-me
# Connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONN_TIMEOUT_MS=30000
DB_POOL_QUERY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Oracle privileged accounts (migrations / DDL only)
# ---------------------------------------------------------------------------
DB_MIGRATION_USERNAME=AV_MIGRATION
DB_MIGRATION_PASSWORD=change-me
DB_APP_ADMIN_USERNAME=sys
DB_APP_ADMIN_PASSWORD=oracle
DB_APP_ADMIN_ROLE=sysdba

# ---------------------------------------------------------------------------
# Sessions and security
# ---------------------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Mail (optional; blank disables mail notifications)
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# CORS (comma-separated allowed origins)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false